# Copy this file to .env and fill in real values. Never commit the real .env.

# GreenAPI instance credentials (from your GreenAPI personal cabinet).
GREEN_API_ID_INSTANCE=1101...
GREEN_API_TOKEN=your-token-here

# Chigo's AI local llama server (runs your own model on your machine).
LLAMA_SERVER=http://127.0.0.1:8080/v1
LOCAL_MODEL=Qwen2.5-1.5B-Instruct

# How the AI should behave. Edit freely.
AI_PERSONA=You are a friendly personal assistant who replies to WhatsApp messages on behalf of the owner. Be warm, natural and concise (keep replies under 150 words). Chat in the same language you are written in. If you cannot answer something, say so plainly and offer to pass it to the owner.
AI_LOCALE=en-ZA

# Where the conversation history JSON file lives (set to a persistent volume in Docker).
DATA_DIR=./data

# ============================================================
# WhatsApp AI Bridge (bridge/bridge.js) - no GreenAPI needed
# ============================================================
# Brain: chigos-ai agent server if running, else raw local llama.
CHIGOS_API_URL=http://127.0.0.1:8000
CHIGOS_MASTER_CODE=@T16i11n20k06
LLAMA_URL=http://127.0.0.1:8080/v1

# Human-like persona used when talking directly to the local model.
BOT_PERSONA=You are the WhatsApp auto-replier of a busy person. Reply exactly like a real human texting on WhatsApp: natural, warm, casual. Keep replies short like a chat message. Match the other person's language. No lists, no markdown, no 'as an AI'.

# Behaviour tweaks
IGNORE_GROUPS=true
MAX_HISTORY=12
# SESSION_DIR=./bridge/session