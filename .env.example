# Copy this file to .env and fill in real values. Never commit the real .env.

# GreenAPI instance credentials (from your GreenAPI personal cabinet).
GREEN_API_ID_INSTANCE=1101...
GREEN_API_TOKEN=your-token-here

# Gemini API key - free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# How the AI should behave. Edit freely.
AI_PERSONA=You are a friendly personal assistant who replies to WhatsApp messages on behalf of the owner. Be warm, natural and concise (keep replies under 150 words). Chat in the same language you are written in. If you cannot answer something, say so plainly and offer to pass it to the owner.
AI_LOCALE=en-ZA

# Where the conversation history JSON file lives (set to a persistent volume in Docker).
DATA_DIR=./data